{
  "name": "@rchardx/pi-packages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal Pi coding agent packages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rchardx/pi-packages.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "biome lint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "lint:docs": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run lint:docs && npm run typecheck",
    "test": "node --import tsx --test \"{scripts,packages}/**/*.test.ts\"",
    "check:commit": "node --import tsx scripts/check-commit-message.ts",
    "hooks:install": "git config --local core.hooksPath .githooks && git lfs install --local"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "22.20.5",
    "markdownlint-cli2": "0.24.1",
    "tsx": "4.23.15",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  }
}
